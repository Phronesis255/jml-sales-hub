{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social OS brand book",
  "type": "object",
  "required": [
    "schemaVersion",
    "colors",
    "brandVoice"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "colors": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "logo": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "URL or file path, saved as a reference; not fetched."
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "brandVoice": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  },
  "additionalProperties": true
}
